# ---------- LLM(解读 + 精筛共用) ----------
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
# true 时不调真实 LLM,返回确定性演示数据(离线开发)
LLM_MOCK=true

# ---------- 伴读联网检索 ----------
TAVILY_API_KEY=

# ---------- GitHub ----------
# 平台 app token:读公开信息 + 爬取配额(5000/h);缺省 60/h 仅够 smoke
GITHUB_TOKEN=
# OAuth 登录(callback: https://<domain>/api/auth/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# true 时不访问真实 GitHub(离线开发);生产必须 false
GITHUB_MOCK=true

# ---------- 会话 ----------
# 生产(GITHUB_MOCK=false)必填,否则后端拒绝启动
SESSION_SECRET=
FRONTEND_ORIGIN=http://localhost:5173

# ---------- 数据库 ----------
DB_PATH=meecode.db
